# Copy these values into your environment when you want real email OTP delivery.
BUDGETBUDDY_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DATABASE_URL=sqlite:///./budgetbuddy.db
OTP_EXPIRE_MINUTES=10

# Gmail example: use a Gmail App Password, not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_FROM=your-email@gmail.com
